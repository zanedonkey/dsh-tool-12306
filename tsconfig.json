{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "verbatimModuleSyntax": true,
    "declaration": true, "sourceMap": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
